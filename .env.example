# NutriVision AI – copy this file to .env and fill in your values

# Supabase project URL (Settings → API → Project URL)
# Do NOT append /rest/v1/ — use only the root project URL
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase anon / publishable key (Settings → API → anon public or publishable key)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Google Gemini API key (https://aistudio.google.com/apikey)
VITE_GEMINI_API_KEY=your-gemini-api-key
