# NutriVision AI Environment Configuration

# Server Port
PORT=3000

# Security & Authentication
JWT_SECRET="nutrivision-secure-jwt-academic-secret-key-2025"
JWT_EXPIRES_IN="7d"

# Database Configuration (PostgreSQL / SQLite fallback)
DATABASE_URL="postgresql://nutrivision:secret@localhost:5432/nutrivision_db"

# AI Vision Service Configuration
AI_PROVIDER="gemini"
AI_API_KEY="MY_GEMINI_API_KEY"

# Gemini API Key (Automatically injected in AI Studio runtime if configured)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# App Hosting URL
APP_URL="http://localhost:3000"
